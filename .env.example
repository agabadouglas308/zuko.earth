# NASA Earthdata login (used by earthaccess for GPM IMERG)
EARTHDATA_USERNAME=your_edl_username
EARTHDATA_PASSWORD=your_edl_password

# NASA FIRMS MAP_KEY (used in Chunk 8 alerts; placeholder for now)
FIRMS_MAP_KEY=your_firms_map_key

# Telegram (used in Chunk 8)
TELEGRAM_BOT_TOKEN=123456:ABC-xxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# Set true to force cached-only mode (no network calls)
DEMO_MODE=false
